# PostgreSQL connection (use your locally installed PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindspark_saas?schema=public"

# Server
PORT=4000
NODE_ENV=development

# CORS - frontend origin
CLIENT_URL="http://localhost:5173"

# JWT secrets: use distinct 32+ byte random values. Production refuses placeholder/weak values.
JWT_ACCESS_SECRET="replace-with-a-random-32-byte-or-longer-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-32-byte-or-longer-secret"
JWT_WATCH_SECRET="replace-with-a-third-random-32-byte-or-longer-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# File storage (local disk)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=25

# Email (optional — without SMTP, invite links are logged to the server console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mindspark LMS <your@gmail.com>"

# Public API URL (PayHere notify callbacks)
API_PUBLIC_URL="http://localhost:4000"

# Cron / smart jobs (protects /api/cron/*)
# Use a unique 32+ byte random secret; send it only in the x-cron-secret header.
CRON_SECRET="replace-with-a-random-32-byte-or-longer-secret"

# PayHere environment: true only for sandbox checkout.
PAYHERE_SANDBOX=true

# AI study coach (optional — without a key, rule-based explanations are used)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Maximum Anthropic calls per teacher/admin per billing month.
TEACHER_AI_MONTHLY_LIMIT=200

# Jitsi Meet (required in production to enforce moderator permissions)
JITSI_HOST="meet.jit.si"
JITSI_APP_ID=""
JITSI_APP_SECRET=""

# Notification Management Service — POST {NMS_BASE_URL}/v1/communications
# Local:  http://localhost:8080  → http://localhost:8080/v1/communications
# Shared/dev/prod: https://<nms-host> → https://<nms-host>/v1/communications
# Full path is also accepted: https://<nms-host>/v1/communications
# Set empty to skip dispatch.
NMS_BASE_URL="http://localhost:8080"
# Shared with NMS NMS_JWT_HS256_SECRET. Leave empty only if NMS is in local header-auth mode.
NMS_JWT_HS256_SECRET=""
