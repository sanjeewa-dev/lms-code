# PostgreSQL connection (use your locally installed PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindspark_saas?schema=public"

# Server
PORT=4000
NODE_ENV=development

# CORS - frontend origin
CLIENT_URL="http://localhost:5173"

# JWT secrets (change these in production)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# File storage (local disk)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=25

# Email (optional — without SMTP, invite links are logged to the server console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mindspark LMS <your@gmail.com>"

# Public API URL (PayHere notify callbacks)
API_PUBLIC_URL="http://localhost:4000"

# Cron / smart jobs (protects /api/cron/*)
CRON_SECRET="change-me-cron-secret"

# AI study coach (optional — without a key, rule-based explanations are used)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Jitsi Meet (optional — without keys, public meet.jit.si is used without moderator enforcement)
JITSI_HOST="meet.jit.si"
JITSI_APP_ID=""
JITSI_APP_SECRET=""
