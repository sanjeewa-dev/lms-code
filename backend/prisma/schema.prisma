generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  superadmin
  admin
  teacher
  student
}

enum EnrollmentStatus {
  pending
  active
  rejected
}

enum UserStatus {
  pending
  approved
  rejected
}

enum PaymentStatus {
  pending
  approved
  rejected
}

enum PaymentType {
  enrollment
  monthly
  material
}

enum MaterialOrderStatus {
  approval_pending
  active
  processing
  delivered
  cancelled
  rejected
}

enum MaterialKind {
  material
  assessment
}

enum MeetingPlatform {
  zoom
  teams
  google_meet
  jitsi
}

enum SessionStatus {
  scheduled
  live
  ended
}

enum FileKind {
  slip
  material
  submission
  cover
  avatar
  video
  logo
  shipping_label
}

enum VideoProvider {
  upload
  youtube
  vimeo
  url
}

enum VideoVisibility {
  all
  class
  batch
}

enum NoticeScope {
  all
  classes
}

enum EventScope {
  all
  classes
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum NotificationType {
  notice
  payment_approved
  payment_rejected
  grade_posted
  assignment_due
  schedule_reminder
  chat_message
  general
}

enum TenantPlan {
  pro
  enterprise
}

enum SelfEnrollmentScope {
  all_classes
  selected_classes
}

enum SelfEnrollmentAudience {
  all_students
  batches
  enrolled_in_classes
}

enum JobRunStatus {
  running
  success
  failed
}

enum EmailLogStatus {
  sent
  failed
  skipped
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  isActive  Boolean  @default(true)
  plan                    TenantPlan @default(pro)
  planFeatures            Json?
  contactEmail        String?
  contactPhone        String?
  bankName            String?
  bankAccountName     String?
  bankAccountNumber   String?
  bankBranch          String?
  paymentInstructions String?  @db.Text
  graceDays               Int     @default(7)
  requireMonthlyPayment   Boolean @default(true)
  payhereMerchantId       String?
  payhereMerchantSecret   String?
  payhereEnabled          Boolean @default(false)
  selfEnrollmentEnabled   Boolean @default(false)
  selfEnrollmentScope     SelfEnrollmentScope @default(selected_classes)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  classes      Class[]
  enrollments  Enrollment[]
  payments     Payment[]
  materials    Material[]
  submissions  Submission[]
  quizzes      Quiz[]
  questions    Question[]
  attempts     QuizAttempt[]
  answers      Answer[]
  files        File[]
  batches      Batch[]
  videoLessons VideoLesson[]
  classTopics  ClassTopic[]
  notices      Notice[]
  events       Event[]
  studentInvites StudentInvite[]
  adminInvites   AdminInvite[]
  classInviteLinks ClassInviteLink[]
  classSchedules ClassSchedule[]
  attendances    Attendance[]
  notifications  Notification[]
  aiUsages       AiUsage[]
  aiStaffUsages  AiStaffUsage[]
  aiToolHistories AiToolHistory[]
  interventions  Intervention[]
  parentTokens   ParentToken[]
  auditLogs      AuditLog[]
  jobRuns        JobRun[]
  emailLogs      EmailLog[]
  supportSessions SupportSession[]
  conversations  Conversation[]
  chatMessages   Message[]
  selfEnrollmentRules SelfEnrollmentRule[]
  materialOrders      MaterialOrder[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  email          String
  passwordHash   String?
  role           Role       @default(student)
  status         UserStatus @default(approved)
  phone          String?
  phones         String[]  @default([])
  guardianName   String?
  guardianPhone  String?
  guardianEmail  String?
  area           String?
  district       String?
  school         String?
  address        String?
  freeIdCard     Boolean   @default(false)
  subject        String?
  avatarFileId   String?
  shippingLabelPhotoFileId String?   @unique
  shippingLabelPhotoFile   File?     @relation("UserShippingLabelPhoto", fields: [shippingLabelPhotoFileId], references: [id], onDelete: SetNull)
  shippingLabelPhotoOnly   Boolean   @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  classesOwned       Class[]         @relation("TeacherClasses")
  enrollments        Enrollment[]
  submissions        Submission[]
  attempts           QuizAttempt[]
  files              File[]
  reviewedPayments   Payment[]       @relation("PaymentReviewer")
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  invitesSent        StudentInvite[] @relation("InvitesSent")
  invitesReceived    StudentInvite[] @relation("InvitesReceived")
  adminInvitesSent   AdminInvite[]   @relation("AdminInvitesSent")
  adminInvitesReceived AdminInvite[] @relation("AdminInvitesReceived")
  classInviteLinksCreated ClassInviteLink[] @relation("ClassInviteLinkCreator")
  noticeReads        NoticeRead[]
  attendancesMarked  Attendance[]    @relation("AttendanceMarker")
  attendances        Attendance[]    @relation("AttendanceStudent")
  notifications      Notification[]
  aiUsages           AiUsage[]
  aiStaffUsages      AiStaffUsage[]
  aiToolHistories    AiToolHistory[]
  interventionsAbout Intervention[]  @relation("InterventionStudent")
  interventionsBy    Intervention[]  @relation("InterventionCreator")
  parentTokens       ParentToken[]   @relation("ParentTokenStudent")
  auditLogs          AuditLog[]
  supportSessions    SupportSession[] @relation("SupportSessionActor")
  conversationsAsTeacher Conversation[] @relation("ConversationTeacher")
  conversationsAsStudent Conversation[] @relation("ConversationStudent")
  chatMessages       Message[]        @relation("MessageSender")
  materialOrders     MaterialOrder[]  @relation("MaterialOrderStudent")
  materialOrdersReviewed MaterialOrder[] @relation("MaterialOrderReviewer")
  materialOrdersCancelled MaterialOrder[] @relation("MaterialOrderCanceller")

  @@unique([tenantId, email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One-time password reset tokens (hashed at rest).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model File {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  kind         FileKind
  createdAt    DateTime @default(now())

  materials    Material[]
  submissions  Submission[]
  paymentSlips Payment[]
  classCovers  Class[]
  videoLessons VideoLesson[]
  materialOrders MaterialOrder[]
  shippingLabelUsers User[] @relation("UserShippingLabelPhoto")

  @@index([tenantId])
  @@index([ownerId])
}

model Batch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  year      Int?
  createdAt DateTime @default(now())

  classes      Class[]
  videoLessons VideoLesson[]
  selfEnrollmentRuleBatches SelfEnrollmentRuleSourceBatch[]

  @@index([tenantId])
}

model Class {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  description  String   @default("")
  price        Decimal  @default(0) @db.Decimal(10, 2)
  coverImageId String?
  coverImage   File?    @relation(fields: [coverImageId], references: [id])
  teacherId    String
  teacher      User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  batchId      String?
  batch        Batch?   @relation(fields: [batchId], references: [id])
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments  Enrollment[]
  materials    Material[]
  submissions  Submission[]
  quizzes      Quiz[]
  videoLessons VideoLesson[]
  topics       ClassTopic[]
  studentInvites StudentInvite[]
  classInviteLinks ClassInviteLink[]
  noticeClasses  NoticeClass[]
  eventClasses   EventClass[]
  schedules      ClassSchedule[]
  attendances    Attendance[]
  aiUsages       AiUsage[]
  aiToolHistories AiToolHistory[]
  selfEnrollmentTargetRules SelfEnrollmentRule[] @relation("SelfEnrollmentTarget")
  selfEnrollmentSourceRules SelfEnrollmentRuleSourceClass[] @relation("SelfEnrollmentSource")
  materialOrderItems MaterialOrderItem[]

  @@index([tenantId])
  @@index([teacherId])
}

model SelfEnrollmentRule {
  id            String                   @id @default(cuid())
  tenantId      String
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetClassId String
  targetClass   Class                    @relation("SelfEnrollmentTarget", fields: [targetClassId], references: [id], onDelete: Cascade)
  audience      SelfEnrollmentAudience
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  sourceClasses SelfEnrollmentRuleSourceClass[]
  sourceBatches SelfEnrollmentRuleSourceBatch[]

  @@unique([tenantId, targetClassId])
  @@index([tenantId])
}

model SelfEnrollmentRuleSourceClass {
  ruleId  String
  classId String
  rule    SelfEnrollmentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  class   Class              @relation("SelfEnrollmentSource", fields: [classId], references: [id], onDelete: Cascade)

  @@id([ruleId, classId])
}

model SelfEnrollmentRuleSourceBatch {
  ruleId  String
  batchId String
  rule    SelfEnrollmentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  batch   Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([ruleId, batchId])
}

model ClassSchedule {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId     String
  class       Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  classDate   DateTime        @db.Date
  classTime   String
  platform    MeetingPlatform
  meetingText String          @default("")
  externalMeetingUrl String?
  status      SessionStatus   @default(scheduled)
  roomName    String?
  startedAt   DateTime?
  endedAt     DateTime?
  recordingUrl String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
  @@index([classId])
  @@index([classDate])
  @@index([status])
}

model Attendance {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId     String
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  scheduleId  String?
  studentId   String
  student     User             @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  sessionDate DateTime         @db.Date
  status      AttendanceStatus @default(present)
  note        String?
  markedById  String
  markedBy    User             @relation("AttendanceMarker", fields: [markedById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([classId, studentId, sessionDate])
  @@index([tenantId])
  @@index([classId])
  @@index([studentId])
  @@index([sessionDate])
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(general)
  title     String
  body      String           @default("")
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([tenantId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model StudentInvite {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId       String?
  class         Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  token         String    @unique
  email         String
  name          String
  phone         String?
  phones        String[]  @default([])
  guardianName  String?
  guardianPhone String?
  area          String?
  district      String?
  school        String?
  address       String?
  freeIdCard    Boolean   @default(false)
  /// Amount waived from class fee for financially assisted students (Rs.).
  feeWaiverAmount Decimal  @default(0) @db.Decimal(10, 2)
  invitedById   String
  invitedBy     User      @relation("InvitesSent", fields: [invitedById], references: [id])
  userId        String?
  user          User?     @relation("InvitesReceived", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([email])
  @@index([classId])
}

model AdminInvite {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token       String    @unique
  email       String
  invitedById String
  invitedBy   User      @relation("AdminInvitesSent", fields: [invitedById], references: [id])
  userId      String?
  user        User?     @relation("AdminInvitesReceived", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([email])
}

model Enrollment {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    EnrollmentStatus @default(pending)
  /// Amount waived from class.price for this enrollment (free-card / fee assistance).
  feeWaiverAmount Decimal    @default(0) @db.Decimal(10, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  payments Payment[]

  @@unique([classId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

/// Reusable shareable invite link for a specific class (open enrollment via link).
model ClassInviteLink {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  token       String    @unique
  createdById String
  createdBy   User      @relation("ClassInviteLinkCreator", fields: [createdById], references: [id])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([classId])
  @@index([tenantId])
  @@index([token])
}

model Payment {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Set when paymentType is material (paid tute / class material purchase).
  materialId   String?
  material     Material?     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  slipFileId   String
  slipFile     File          @relation(fields: [slipFileId], references: [id])
  paymentType  PaymentType   @default(monthly)
  forMonth     String        @default("2026-01") // YYYY-MM billing period (or purchase month for materials)
  status       PaymentStatus @default(pending)
  /// PayHere (or other gateway) order id — bound at checkout init
  orderId      String?       @unique
  reviewedById String?
  reviewedBy   User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  note         String?
  createdAt    DateTime      @default(now())

  @@index([tenantId])
  @@index([enrollmentId])
  @@index([materialId])
  @@index([status])
  @@index([forMonth])
  @@index([enrollmentId, forMonth])
  @@index([paymentType])

  materialOrderItem MaterialOrderItem?
}

model Material {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  description String       @default("")
  kind        MaterialKind @default(material)
  fileId      String?
  file        File?        @relation(fields: [fileId], references: [id])
  pageCount   Int          @default(1)
  viewOnly    Boolean      @default(true)
  /// 0 = free; >0 = paid tute (requires approved material payment to preview).
  price       Decimal      @default(0) @db.Decimal(10, 2)
  published   Boolean      @default(true)
  dueDate     DateTime?
  maxMarks    Float?
  createdAt   DateTime     @default(now())

  submissions Submission[]
  payments    Payment[]
  orderItems  MaterialOrderItem[]

  @@index([tenantId])
  @@index([classId])
}

model MaterialOrder {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId        String
  student          User                @relation("MaterialOrderStudent", fields: [studentId], references: [id], onDelete: Cascade)
  orderNo          String
  shippingLabelNo  String?
  status           MaterialOrderStatus @default(approval_pending)
  recipientName    String
  email            String
  phone            String
  address          String
  grade            String              @default("")
  remarks          String?             @db.Text
  slipFileId       String
  slipFile         File                @relation(fields: [slipFileId], references: [id])
  reviewedById     String?
  reviewedBy       User?               @relation("MaterialOrderReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelledBy      User?               @relation("MaterialOrderCanceller", fields: [cancelledById], references: [id])
  cancelNote       String?
  statusChangedAt  DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  items MaterialOrderItem[]

  @@unique([tenantId, orderNo])
  @@unique([tenantId, shippingLabelNo])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([studentId])
  @@index([slipFileId])
}

model MaterialOrderItem {
  id            String        @id @default(cuid())
  orderId       String
  order         MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId     String        @unique
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  classId       String
  class         Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  materialTitle String
  classTitle    String
  amount        Decimal       @db.Decimal(10, 2)

  @@index([orderId])
  @@index([classId])
  @@index([materialId])
}

model Submission {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId      String
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Material? @relation(fields: [assessmentId], references: [id])
  studentId    String
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileId       String
  file         File      @relation(fields: [fileId], references: [id])
  grade        Float?
  feedback     String?
  submittedAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([classId])
  @@index([studentId])
}

model Quiz {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId       String
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  title         String
  description   String    @default("")
  timeLimitSec  Int       @default(0)
  totalMarks    Float     @default(0)
  availableFrom DateTime?
  availableTo   DateTime?
  isPublished   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  questions Question[]
  attempts  QuizAttempt[]

  @@index([tenantId])
  @@index([classId])
}

model Question {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text         String
  options      Json
  correctIndex Int
  marks        Float    @default(1)
  order        Int      @default(0)

  answers Answer[]

  @@index([tenantId])
  @@index([quizId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?

  answers Answer[]

  @@unique([quizId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model Answer {
  id                String      @id @default(cuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attemptId         String
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex     Int
  explanation       String?     @db.Text
  explanationSteps  Json?

  @@unique([attemptId, questionId])
  @@index([tenantId])
}

/// Monthly AI Student Area quota: 20 tokens per student per class.
model AiUsage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  forMonth  String
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, classId, forMonth])
  @@index([tenantId])
  @@index([classId])
}

/// Monthly AI usage for teachers/admins (copilot tools).
model AiStaffUsage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  forMonth  String
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, forMonth])
  @@index([tenantId])
}

/// Saved AI Student Area tool responses for later review.
model AiToolHistory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  tool      String
  title     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([studentId, classId, tool, createdAt])
}

enum InterventionStatus {
  open
  in_progress
  resolved
  escalated
}

/// Tracks teacher interventions and follow-ups for at-risk students.
model Intervention {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String
  student     User               @relation("InterventionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User               @relation("InterventionCreator", fields: [createdById], references: [id])
  reason      String             @db.Text
  action      String             @db.Text
  status      InterventionStatus @default(open)
  followUpDate DateTime?
  resolvedAt  DateTime?
  resolvedNote String?           @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([createdById])
}

/// Parent magic-link tokens for the Parent Trust Center.
model ParentToken {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation("ParentTokenStudent", fields: [studentId], references: [id], onDelete: Cascade)
  token      String   @unique
  email      String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([studentId])
  @@index([token])
}

model ClassTopic {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  videos VideoLesson[]

  @@index([tenantId])
  @@index([classId])
  @@unique([classId, title])
}

model VideoLesson {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String          @default("")
  provider    VideoProvider   @default(upload)
  videoUrl    String          @default("")
  fileId      String?
  file        File?           @relation(fields: [fileId], references: [id])
  visibility  VideoVisibility @default(all)
  classId     String?
  class       Class?          @relation(fields: [classId], references: [id])
  batchId     String?
  batch       Batch?          @relation(fields: [batchId], references: [id])
  topicId     String?
  topic       ClassTopic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  playlistOrder Int           @default(0)
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([topicId])
  @@index([classId, playlistOrder])
}

model Notice {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  body        String      @default("")
  pinned      Boolean     @default(false)
  scope       NoticeScope @default(all)
  publishedAt DateTime    @default(now())

  classes NoticeClass[]
  reads   NoticeRead[]

  @@index([tenantId])
}

model NoticeClass {
  id       String @id @default(cuid())
  noticeId String
  notice   Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([noticeId, classId])
  @@index([classId])
}

model NoticeRead {
  id       String   @id @default(cuid())
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([noticeId, userId])
  @@index([userId])
}

model Event {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title      String
  body       String     @default("")
  eventDate  DateTime
  batchLabel String?
  scope      EventScope @default(all)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())

  classes EventClass[]

  @@index([tenantId])
}

model EventClass {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([eventId, classId])
  @@index([classId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model JobRun {
  id         String       @id @default(cuid())
  job        String
  status     JobRunStatus @default(running)
  tenantId   String?
  tenant     Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  result     Json?
  error      String?      @db.Text

  @@index([job])
  @@index([status])
  @@index([startedAt])
  @@index([tenantId])
}

model EmailLog {
  id          String         @id @default(cuid())
  tenantId    String?
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  to          String
  subject     String
  status      EmailLogStatus
  providerId  String?
  error       String?        @db.Text
  relatedType String?
  relatedId   String?
  createdAt   DateTime       @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model SupportSession {
  id           String    @id @default(cuid())
  superadminId String
  superadmin   User      @relation("SupportSessionActor", fields: [superadminId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reason       String    @db.Text
  tokenHash    String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  expiresAt    DateTime

  @@index([superadminId])
  @@index([tenantId])
  @@index([tokenHash])
}

/// Direct message thread between one staff member (teacher/admin) and one student.
model Conversation {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       User      @relation("ConversationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId     String
  student       User      @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([tenantId, teacherId, studentId])
  @@index([tenantId, teacherId])
  @@index([tenantId, studentId])
}

model Message {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([tenantId])
}
