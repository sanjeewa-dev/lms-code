# Copy to .env in the repo root for local Docker (Mac / Windows):
#   cp .env.docker.example .env          # macOS / Linux / Git Bash
#   Copy-Item .env.docker.example .env   # PowerShell
#
# Never commit .env

# Host port for the app (http://localhost:8080)
HOST_PORT=8080

# Postgres (service hostname inside Compose is "postgres")
POSTGRES_USER=mindspark
POSTGRES_PASSWORD=local-docker-mindspark-password-change-me
POSTGRES_DB=mindspark

# Public origin used by the API (scheme + host, no trailing slash)
CLIENT_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080

# JWT / cron — must be ≥32 characters when NODE_ENV=production (Docker images run as production)
JWT_ACCESS_SECRET=local-docker-access-secret-32chars-min!!
JWT_REFRESH_SECRET=local-docker-refresh-secret-32chars-min!
JWT_WATCH_SECRET=local-docker-watch-secret-32chars-min!!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CRON_SECRET=local-docker-cron-secret-32chars-minimum!!

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=100

# Seed demo tenants/accounts on container start (idempotent)
SEED_ON_START=true

# Notification Management Service — leave empty for local Docker (LMS itself uses :8080)
NMS_BASE_URL=
NMS_JWT_HS256_SECRET=

# Email (optional — without SMTP, invite links log to backend container)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mindspark LMS <noreply@localhost>

# Payments — keep true for local/dev
PAYHERE_SANDBOX=true

# Optional AI / live class
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TEACHER_AI_MONTHLY_LIMIT=200
JITSI_HOST=meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=
